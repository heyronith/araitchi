# Optional override for the Araitchi app data directory.
# Default: OS app-data path (e.g. ~/Library/Application Support/araitchi on macOS,
# %APPDATA%\araitchi on Windows, ~/.local/share/araitchi on Linux).
ARAITCHI_DATA_DIR=

NEXT_TELEMETRY_DISABLED=1

# Optional paper-provider keys (scripts / smoke tests read these from .env.local).
# The app uses Settings → Keys first, then falls back to the same env vars.
# OPENALEX_API_KEY=
# CORE_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# Contact email for Crossref/OpenAlex polite pools and Unpaywall (not a secret).
# Settings → Tools contact email is used in the app, with this env as fallback.
# ARAITCHI_CONTACT_EMAIL=
