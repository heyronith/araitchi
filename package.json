    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "onnxruntime-node": "^1.31.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
